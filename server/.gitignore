<box border radius="xl" padding={3} gap={3}>
  <radio-group value={status} onChange={setStatus} direction="col">
    <radio value="done">DONE — `.gitignore` created and verified</radio>
    <radio value="error">ERROR — I encountered an issue</radio>
  </radio-group>
  {#if status === "error"}
    <textarea value={error} onChange={setError} placeholder="Paste the command output or error here..." rows={3}/>
  {/if}
  <button block onClick={() => GenUI.issueNewTurn(status === "done" ? "DONE — Step 6 completed. Proceed to Step 7, one actionable step at a time." : "ERROR — Step 6 failed. Help me debug it before proceeding.\nDetails:\n"+(error || "No error details provided"))}>{status === "done" ? "Confirm and continue" : "Help me fix the error"}</button>
</box>


